# ============================================================
# ไฟล์กำหนดค่าระบบ (.env_real) — สำหรับ host จริง (Production)
# ============================================================

# ----- สภาพแวดล้อมที่รันโค้ด -----
# development = พัฒนาบนเครื่อง (localhost/MAMP)
# production  = ใช้งานจริงบน host จริง
APP_ENV=production

# ============================================================
# การตั้งค่าสำหรับ host จริง (แก้ไขให้ตรงกับ host ของคุณ)
# ============================================================

# ----- ฐานข้อมูลจริง -----
# บน shared hosting ส่วนใหญ่ DB_HOST มักเป็น localhost
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ชื่อฐานข้อมูลจริงของคุณ
DB_USERNAME=ชื่อผู้ใช้ฐานข้อมูลจริง
DB_PASSWORD=รหัสผ่านฐานข้อมูลจริง

# ----- อีเมล: โหมดใช้งานจริง (ส่งจริงผ่าน SMTP) -----
MAIL_DRIVER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=อีเมลของคุณ@domain.com
MAIL_PASS=รหัสผ่านหรือ App Password ของคุณ
MAIL_FROM=อีเมลของคุณ@domain.com
MAIL_FROM_NAME=Thepha Care

# ----- การรายงานข้อผิดพลาด (ปิดใน production) -----
APP_DEBUG=false